CONFIG_LOCALVERSION="-Petrichor"
CONFIG_DEBUG_SECTION_MISMATCH=y

#Wireguard
CONFIG_WIREGUARD=y

#spoof Cmdline
CONFIG_PROC_SPOOF_CMDLINE=y

#Gamepad
CONFIG_HID_PANTHERLORD=y
CONFIG_PANTHERLORD_FF=y

#bbr
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
# CONFIG_TCP_CONG_CUBIC is not set
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y

#fgetpriority
CONFIG_FGETPRIORITY=y

#KernelSU
CONFIG_KSU=y
CONFIG_KSU_KPROBES_KSUD=n
CONFIG_KSU_HACK_ARM64_BRANCH_LINK=n
CONFIG_KSU_TAMPER_SYSCALL_TABLE=n
CONFIG_KSU_DISABLE_32BIT_HOOKS=n
CONFIG_KSU_LSM_SECURITY_HOOKS=y
CONFIG_KSU_FEATURE_SULOG=y
CONFIG_KSU_FEATURE_ADBROOT=y
CONFIG_KSU_HOSTSREDIRECT=n
CONFIG_KSU_ENABLE_FULL_UID_CHECKS=n
CONFIG_KSU_THRONE_TRACKER_ALWAYS_THREADED=n
CONFIG_KSU_NOPRINTK=n
CONFIG_KSU_SHELL_HAS_SU_ALWAYS=n
CONFIG_KSU_DEBUG=n
CONFIG_KSU_HEURISTIC_IN_TREE_BUILD=y

# enable Walt and bore
# CONFIG_CPU_FREQ_GOV_SCHEDUTIL is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_WALT=y
CONFIG_CPU_FREQ_GOV_WALT=y
CONFIG_SCHED_BORE=y

# disabled CPU errata (not present on SDM710 A75+A55)
# A53
# CONFIG_ARM64_ERRATUM_826319 is not set
# CONFIG_ARM64_ERRATUM_827319 is not set
# CONFIG_ARM64_ERRATUM_824069 is not set
# CONFIG_ARM64_ERRATUM_819472 is not set
# CONFIG_ARM64_ERRATUM_845719 is not set
# CONFIG_ARM64_ERRATUM_843419 is not set

# A57
# CONFIG_ARM64_ERRATUM_832075 is not set

# A57/A72
# CONFIG_ARM64_ERRATUM_1742098 is not set

# A76
# CONFIG_ARM64_ERRATUM_1188873 is not set

# Cavium ThunderX
# CONFIG_CAVIUM_ERRATUM_22375 is not set
# CONFIG_CAVIUM_ERRATUM_23154 is not set
# CONFIG_CAVIUM_ERRATUM_27456 is not set

# QDF2400 server
# CONFIG_QCOM_QDF2400_ERRATUM_0065 is not set

# disable Driver Logging 
# CONFIG_SCSI_LOGGING is not set
# CONFIG_SCSI_UFSHCD_CMD_LOGGING is not set
# CONFIG_SCSI_CONSTANTS is not set
# CONFIG_DM_DEBUG is not set
# CONFIG_SPMI_MSM_PMIC_ARB_DEBUG is not set
# CONFIG_VIDEO_ADV_DEBUG is not set
# CONFIG_MSM_SDE_ROTATOR_EVTLOG_DEBUG is not set
# CONFIG_DRM_SDE_EVTLOG_DEBUG is not set
# CONFIG_MMC_PERF_PROFILING is not set
# CONFIG_MMC_TEST is not set
# CONFIG_IOMMU_DEBUG is not set
# CONFIG_IOMMU_DEBUG_TRACKING is not set
# CONFIG_IOMMU_TESTS is not set
# CONFIG_RMNET_DATA_DEBUG_PKT is not set
# CONFIG_IPC_LOGGING is not set
# CONFIG_NETFILTER_XT_TARGET_LOG is not set
# CONFIG_NETFILTER_XT_TARGET_NFLOG is not set
# CONFIG_NETFILTER_XT_MATCH_STATISTIC is not set
# CONFIG_MSM_TZ_LOG is not set
# CONFIG_MSM_BOOT_STATS is not set
# CONFIG_QCOM_RUN_QUEUE_STATS is not set
# CONFIG_QCOM_MEMORY_DUMP_V2 is not set
# CONFIG_QCOM_MINIDUMP is not set
# CONFIG_CPU_FREQ_STAT is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_TASKSTATS is not set
# CONFIG_TASK_XACCT is not set
# CONFIG_TASK_IO_ACCOUNTING is not set
# CONFIG_UID_SYS_STATS is not set
# CONFIG_MEMORY_STATE_TIME is not set
# CONFIG_XFRM_STATISTICS is not set
# CONFIG_KALLSYMS_ALL is not set

# disable Debug
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_ALIGN_RODATA is not set
# CONFIG_REGMAP_ALLOW_WRITE_DEBUGFS is not set
# CONFIG_QMP_DEBUGFS_CLIENT is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_LOCKDEP is not set
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_HARDLOCKUP_DETECTOR is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_CPU_FREQ_SWITCH_PROFILER is not set
# CONFIG_TRACER_PKT is not set
# CONFIG_NETFILTER_XT_TARGET_TRACE is not set


# disable Tracing & Logging
# CONFIG_PROFILING is not set
# CONFIG_IPC_LOGGING is not set
# CONFIG_TRACER_PKT is not set
# CONFIG_MSM_TZ_LOG is not set
# CONFIG_QMP_DEBUGFS_CLIENT is not set

# disable CoreSight HW Tracing
# CONFIG_CORESIGHT is not set

# I/O sched to deadline
CONFIG_DEFAULT_DEADLINE=y
# CONFIG_DEFAULT_CFQ is not set
# CONFIG_DEFAULT_NOOP is not set

# disable this mitigation overhead
# CONFIG_UNMAP_KERNEL_AT_EL0 is not set
# CONFIG_HARDEN_BRANCH_PREDICTOR is not set
# CONFIG_ARM64_SSBD is not set
# CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY is not set
